rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Birthday configuration document
    match /birthday_config/{configId} {
      allow get: if true;
      allow list: if false; // Disallow querying indices
      
      allow create, update: if (
        request.resource.data.id == 'active' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.relation is string &&
        request.resource.data.relation.size() > 0 &&
        request.resource.data.relation.size() <= 80 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() > 0 &&
        request.resource.data.date.size() <= 40
      );
    }
  }
}
